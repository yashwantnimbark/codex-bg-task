#!/bin/bash
# codex-feed-stop - stop the feed injector service for a Codex tmux session.
# Usage: codex-feed-stop [session-name]

set -u

SESSION="${1:-codex}"
QUIET="${2:-}"
MON_DIR="$HOME/.codex/monitors"

slug_session() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

SLUG="$(slug_session "$SESSION")"
SERVICE="codex-feed-injector-${SLUG}"
PID_FILE="$MON_DIR/feed-injector-${SLUG}.pid"
LOCK_DIR="$MON_DIR/feed-injector-${SLUG}.lock"
FIFO="$MON_DIR/feed-injector-${SLUG}.fifo"

say() {
  [ "$QUIET" = "--quiet" ] && return 0
  printf '%s\n' "$*"
}

if tmux has-session -t "$SERVICE" 2>/dev/null; then
  tmux kill-session -t "$SERVICE" 2>/dev/null || true
  say "Stopped tmux service session '$SERVICE'"
fi

if [ -s "$PID_FILE" ]; then
  PID="$(cat "$PID_FILE" 2>/dev/null || true)"
  if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
    CHILDREN="$(ps -axo pid=,ppid= | awk -v p="$PID" '$2 == p { print $1 }')"
    [ -n "$CHILDREN" ] && kill $CHILDREN 2>/dev/null || true
    kill "$PID" 2>/dev/null || true
    sleep 0.3
    [ -n "$CHILDREN" ] && kill -9 $CHILDREN 2>/dev/null || true
    kill -9 "$PID" 2>/dev/null || true
    say "Stopped feed injector pid $PID"
  fi
fi

rm -f "$PID_FILE" "$FIFO"
rm -rf "$LOCK_DIR"
say "Feed injector stopped for session '$SESSION'"
